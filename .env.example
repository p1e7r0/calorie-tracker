# Pooled connection string for the app (Neon: hostname with -pooler)
DATABASE_URL=postgres://calorie:calorie@localhost:5433/calorie_tracker
# Direct connection string for migrations (Neon: hostname without -pooler)
DATABASE_URL_UNPOOLED=postgres://calorie:calorie@localhost:5433/calorie_tracker
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Optional, comma separated: extra origins allowed to sign in (e.g. the dev server on your LAN)
BETTER_AUTH_TRUSTED_ORIGINS=
# Optional: enables "Continua con Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: password reset emails through Resend (without them, development prints the link in the server log)
RESEND_API_KEY=
EMAIL_FROM=Bilancia <bilancia@example.com>
# Optional: AI helpers (nutrition label photo, meal description)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
